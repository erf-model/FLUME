# ERF with FLUME as its flood engine, the rain from ERF's WDM6 microphysics,
# rain, snow and graupel (flume.rain.type = microphysics in the FLUME deck,
# FILE=<path>/flume_cells). A cold, shallow moist bubble over ground below
# freezing: much of what reaches the ground is frozen, and FLUME takes it as
# liquid water. 20 x 0.4 x 5 km in 200 x 4 x 50 cells in two boxes, ERF's
# step erf.fixed_dt = 0.5 s cut by its CFL limit (about 0.36 s), for 200
# steps (72.8 s). The flood grid is ERF's columns (erf.flood.grid_ratio = 1).
# The atmosphere is that of ERF's Tests/test_files/WDM6_ColdBubble_SnowAccum.
erf.prob_name = "Bubble"
erf.init_type = MoistBaseState

max_step  = 200
stop_time = 3600.0

geometry.prob_extent = 20000.0 400.0 5000.0
amr.n_cell           = 200     4     50
amr.max_grid_size    = 100     4     50
amr.max_level        = 0
geometry.is_periodic = 0 1 0
xlo.type = "SlipWall"
xhi.type = "SlipWall"
zlo.type = "SlipWall"
zhi.type = "SlipWall"

erf.fixed_dt = 0.5
erf.fixed_mri_dt_ratio = 4
erf.v = 0

erf.check_int     = -1
erf.plot_file_1   = plt
erf.plot_int_1    = -1
erf.plot2d_file_1 = plt2d
erf.plot2d_int_1  = 100
erf.plot2d_vars_1 = precip_total_accum precip_frozen_accum

erf.use_gravity  = true
erf.use_coriolis = false

erf.dycore_horiz_adv_type    = "Upwind_3rd"
erf.dycore_vert_adv_type     = "Upwind_3rd"
erf.dryscal_horiz_adv_type   = "Upwind_3rd"
erf.dryscal_vert_adv_type    = "Upwind_3rd"
erf.moistscal_horiz_adv_type = "Upwind_3rd"
erf.moistscal_vert_adv_type  = "Upwind_3rd"

erf.les_type       = "None"
erf.pbl_type       = "None"
erf.moisture_model = WDM6
erf.use_wdm6_cpp_answer = 1

erf.molec_diff_type   = "ConstantAlpha"
erf.dynamic_viscosity = 0.0
erf.alpha_T           = 0.0
erf.alpha_C           = 0.0

prob.x_c = 10000.0
prob.z_c =  2000.0
prob.x_r =  2000.0
prob.z_r =  2000.0
prob.T_0 =   300.0

prob.do_moist_bubble = true
prob.theta_pert  = 2.0
prob.qt_init     = 0.004
prob.eq_pot_temp = 280.0

erf.flood.enable     = true
erf.flood.engine     = flume
erf.flood.grid_ratio = 1
erf.flood.plot_file  = flood
erf.flood.plot_int   = 100
