# FLUME's half of the coupled case: the flood on its own, the same in the
# stand-alone run (inputs_standalone) and inside ERF (inputs_erf), which both
# read this file with FILE=<path>/flume_plane on the command line.
#
# Rain of 50 mm/h from t = 0 on a dry impermeable plane, the bed falling by
# 1 cm per metre towards x = 64 m, Manning n = 0.01 s/m^(1/3). A wall at
# x = 0, periodic in y; the water leaves at x = 64 m (zero gradient).
# Every step is flume.max_dt = 0.25 s: the CFL and rain steps of this flood
# stay above 0.99 s to the end (Tests/ERF/README.md), and ERF's fixed step is
# the same 0.25 s.
flume.max_dt = 0.25

flume.bc.segments = out
flume.bc.out.side = xhi
flume.bc.out.type = outflow

flume.friction.manning = 0.01
flume.bed.elevation    = 1.0
flume.bed.slope        = -0.01 0.0

flume.rain.type = constant
flume.rain.rate = 50.0

flume.log_int = 64
flume.gauges.names   = mid outlet
flume.gauges.mid.location    = 32.5 4.5
flume.gauges.outlet.location = 63.5 4.5
