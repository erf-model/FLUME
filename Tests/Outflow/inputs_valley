# Rain on a valley whose bed crests at both open sides: 100 x 2 cells of 1 m
# in 2 boxes, the bed 0.01 |x - 50 m| (bed_valley.asc, named by the tests),
# Manning n = 0.015 s/m^(1/3), dry at the start. Rain of 50 mm/h to 1200 s
# is 3.3333 m3. The bed falls into the domain from sides xlo and xhi, so no
# water flows towards them: all the rain stays. The tests give the type of
# segments west and east.
flume.n_cell        = 100 2
flume.prob_hi       = 100.0 2.0
flume.max_grid_size = 64
flume.plot_file     = valley
flume.plot_int      = 100000
flume.log_int       = 100
flume.stop_time     = 1200.0

flume.bc.segments  = west east
flume.bc.west.side = xlo
flume.bc.east.side = xhi

flume.friction.manning = 0.015
flume.rain.type        = constant
flume.rain.rate        = 50.0
