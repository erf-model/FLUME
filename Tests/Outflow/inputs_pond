# Rain ponding beside open sides: 100 x 50 cells of 2 m in boxes of at most
# 32 cells (8 boxes), a plane falling by 1 cm per metre towards a wall at
# x = 200 m with a roughness of 5 cm, Manning n = 0.015 s/m^(1/3), dry at
# the start. Sides ylo and yhi are open over their whole length. Rain of
# 50 mm/h to 1200 s is 333.33 m3. The water collects against the wall and
# the pond reaches both open sides, over boundary cells that the roughness
# puts above or below their neighbours inside. The tests give the type of
# segments s and n.
flume.n_cell        = 100 50
flume.prob_hi       = 200.0 100.0
flume.max_grid_size = 32
flume.plot_file     = pond
flume.plot_int      = 100000
flume.log_int       = 100
flume.stop_time     = 1200.0

flume.bc.segments = s n
flume.bc.s.side   = ylo
flume.bc.n.side   = yhi

flume.friction.manning = 0.015
flume.bed.elevation    = 2.0
flume.bed.slope        = -0.01 0.0
flume.bed.noise        = 0.05

flume.rain.type = constant
flume.rain.rate = 50.0
