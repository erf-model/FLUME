# Rain on an impermeable plane: 1000 x 2 cells of 0.1 m by 1 m in 4 boxes,
# the bed falling by 1 cm per metre towards x = 100 m, Manning
# n = 0.01 s/m^(1/3). Walls at x = 0 and on the two sides along x; the water
# leaves at x = 100 m (an outflow segment). Rain of 50 mm/h from t = 0 on a dry
# plane. The kinematic-wave solution (Tests/Rain/check_rain.py) reaches
# equilibrium after t_e = 349 s, with 4.8 mm of water and a Froude number
# of 1.3 at the outlet: the flow leaves supercritical, so the outflow side
# sets nothing the flow inside depends on. At equilibrium the outlet passes
# i L = 1.3889e-3 m2/s.
flume.n_cell        = 1000 2
flume.prob_hi       = 100.0 2.0
flume.max_grid_size = 250
flume.plot_file     = plane
flume.plot_int      = 400
flume.stop_time     = 900.0

flume.bc.segments    = out
flume.bc.out.side    = xhi
flume.bc.out.type    = outflow

flume.friction.manning = 0.01
flume.bed.elevation    = 1.0
flume.bed.slope        = -0.01 0.0

flume.rain.type     = constant
flume.rain.rate     = 50.0
